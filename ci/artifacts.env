# ============================================================
# APP IDENTITY
# ============================================================

APP_DISPLAY_NAME="App Flutter"

DART_PACKAGE_NAME=app_flutter

ANDROID_NAMESPACE=com.brunno.app
ANDROID_APPLICATION_ID=com.brunno.app

IOS_BUNDLE_IDENTIFIER=com.brunno.app
